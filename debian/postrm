#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
    purge)
        rm -rf /etc/uplinkmgr
        ;;

    remove)
        # dhcpcd-uplinkmgr.service is already stopped/disabled by prerm; its
        # config lives under /etc/uplinkmgr/, so it's left alone here (like
        # the radvd configs and env files) and only removed on purge.
        # Remove generated files but leave /etc/uplinkmgr/ intact
        rm -f /etc/network/interfaces.d/uplinkmgr.conf
        rm -f /etc/iproute2/rt_tables.d/uplinkmgr.conf
        # uplinkmgr-setup adds a per-instance Wants= from uplinkmgr.service
        # to each radvd-uplinkmgr@<name>.service via `systemctl add-wants`
        # (see bin/uplinkmgr-setup), since the set of instances is dynamic
        # and can't be listed in uplinkmgr.service's own unit file. dpkg
        # doesn't track that drop-in directory, so remove it here.
        rm -rf /etc/systemd/system/uplinkmgr.service.wants
        ;;
esac
