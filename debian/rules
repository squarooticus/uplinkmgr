#!/usr/bin/make -f

export PYBUILD_NAME = uplinkmgr

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Entry-point scripts
	install -d debian/uplinkmgr/usr/sbin
	install -m 755 bin/uplinkmgr bin/uplinkmgr-setup \
	    debian/uplinkmgr/usr/sbin/
	# dhcpcd hook (linked at runtime into whichever dhcpcd-hooks directory
	# dhcpcd-base expects -- see debian/uplinkmgr.triggers and
	# hooks/dhcpcd-hook-link)
	install -d debian/uplinkmgr/usr/lib/uplinkmgr
	install -m 755 hooks/dhcpcd-hook hooks/dhcpcd-hook-link \
	    debian/uplinkmgr/usr/lib/uplinkmgr/
	# radvd systemd template unit file, and uplinkmgr's own dhcpcd unit.
	# dh_installsystemd auto-detects and manages any non-template unit file
	# found anywhere under usr/lib/systemd/system/ in the built tree (not
	# just debian/uplinkmgr.service by name), so dhcpcd-uplinkmgr.service
	# gets the same enable/start/stop/purge handling as uplinkmgr.service --
	# only the *template* radvd-uplinkmgr@.service is excluded from that
	# (no default instance to enable), which is why its enable/disable stays
	# manual, driven by uplinkmgr-setup and prerm (see SPEC.md §6.3, §14.6).
	install -d debian/uplinkmgr/usr/lib/systemd/system
	install -m 644 systemd/radvd-uplinkmgr@.service systemd/dhcpcd-uplinkmgr.service \
	    debian/uplinkmgr/usr/lib/systemd/system/
	# Event hooks: system-installed (package-managed) and
	# administrator-installed drop-in directories, shipped empty.
	install -d debian/uplinkmgr/usr/libexec/uplinkmgr/hooks
	install -d debian/uplinkmgr/etc/uplinkmgr/hooks

# dh_installsystemd handles the uplinkmgr.service unit automatically
# (picks it up from debian/uplinkmgr.service).
